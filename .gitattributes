* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Filament publishes vendor-generated assets that may contain semantic trailing spaces.
/public/css/filament/** -whitespace
/public/js/filament/** -whitespace

# Unified patches require a single space on otherwise blank context lines.
/.devcontainer/telegram-bot-api/*.patch -whitespace

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
