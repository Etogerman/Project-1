APP_NAME="Abrikosoff Connector"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://127.0.0.1:8000

# Local dev admin user — set to seed/update admin@abrikosoff.local on container start
ADMIN_USER_SEEDER_PASSWORD=password

# Optional: pass an explicit public IP to Telegram setWebhook when Telegram DNS lags.
TELEGRAM_WEBHOOK_IP_ADDRESS=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=abrikosoff_connector
DB_USERNAME=abrikosoff
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
INBOUND_MEDIA_QUEUE_CONNECTION=inbound-media
INBOUND_MEDIA_QUEUE_NAME=inbound-media
# Clamped in config above INBOUND_MEDIA_ATTEMPT_DEADLINE_SECONDS.
INBOUND_MEDIA_QUEUE_RETRY_AFTER=21630
BOT_AUTO_REPLY_QUEUE=bot-replies
BOT_SCENARIO_QUEUE=bot-replies
BOT_LEGACY_AUTO_REPLY_RULES_ENABLED=false
BITRIX24_OPENLINES_LIVE_EXPORT_QUEUE=bitrix-live
BOT_PROFILE_COLLECTION_ENGINE=legacy_collector

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru/1.x/
MOSCOW_REFERENCE_LAT=55.7558
MOSCOW_REFERENCE_LNG=37.6173
BOT_DATA_COLLECTION_COMPLETION_MESSAGE="Спасибо, данные сохранили."
BOT_TELEGRAM_WEBHOOK_MAX_PER_MINUTE=300
BOT_MAX_WEBHOOK_MAX_PER_MINUTE=300
BOT_MEDIA_DOWNLOAD_MAX_BYTES=20971520
BOT_MAX_STREAMING_MEDIA_DOWNLOAD_ENABLED=false
TELEGRAM_LOCAL_BOT_API_MEDIA_DOWNLOAD_ENABLED=false
TELEGRAM_LOCAL_BOT_API_BASE_URL=
TELEGRAM_LOCAL_BOT_API_USERNAME=
TELEGRAM_LOCAL_BOT_API_PASSWORD=
TELEGRAM_LOCAL_BOT_API_ALLOW_INSECURE_HTTP=false
TELEGRAM_LOCAL_BOT_API_TRUSTED_HOSTS=telegram-bot-api,localhost,127.0.0.1,::1
TELEGRAM_LOCAL_BOT_API_FILE_TRANSPORT=filesystem
TELEGRAM_LOCAL_BOT_API_FILES_ROOT=
TELEGRAM_LOCAL_BOT_API_FILE_BRIDGE_BASE_URL=
TELEGRAM_LOCAL_BOT_API_FILE_BRIDGE_TRUSTED_HOSTS=telegram-bot-api-file-bridge,localhost,127.0.0.1,::1
TELEGRAM_LOCAL_BOT_API_FILE_BRIDGE_USERNAME=
TELEGRAM_LOCAL_BOT_API_FILE_BRIDGE_PASSWORD=
TELEGRAM_LOCAL_BOT_API_FILE_BRIDGE_MAX_BYTES=67108864
TELEGRAM_ACCOUNT_GATEWAY_MEDIA_UPLOAD_RATE_LIMIT_PER_MINUTE=600
TELEGRAM_ACCOUNT_MEDIA_DOWNLOAD_MAX_BYTES=20971520
TELEGRAM_ACCOUNT_MEDIA_DOWNLOAD_RETRY_DELAY_SECONDS=60
INBOUND_MEDIA_MANUAL_HARD_LIMIT_BYTES=4294967296
# INBOUND_MEDIA_TEMPORARY_DIRECTORY=/var/www/html/storage/app/inbound-media-tmp
INBOUND_MEDIA_RETENTION_DAYS=90
INBOUND_MEDIA_ORPHAN_GRACE_SECONDS=22500
INBOUND_MEDIA_STORAGE_QUOTA_ENFORCE=false
INBOUND_MEDIA_STORAGE_GLOBAL_LIMIT_BYTES=53687091200
INBOUND_MEDIA_STORAGE_CHANNEL_LIMIT_BYTES=21474836480
INBOUND_MEDIA_STORAGE_MINIMUM_FREE_BYTES=10737418240
INBOUND_MEDIA_STORAGE_MINIMUM_FREE_PERCENT=10
INBOUND_MEDIA_TRAFFIC_QUOTA_ENFORCE=false
