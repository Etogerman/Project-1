APP_NAME="Abrikosoff Connector"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=https://ngrok-endpoint.ngrok-free.dev

# Local dev admin user — set to seed/update admin@abrikosoff.local on container start
ADMIN_USER_SEEDER_PASSWORD=password

# ngrok — required for bot webhooks (Telegram / MAX)
# Get your authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
# Get your static domain at https://dashboard.ngrok.com/endpoints
NGROK_AUTHTOKEN=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=abrikosoff_connector
DB_USERNAME=abrikosoff
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru/1.x/
MOSCOW_REFERENCE_LAT=55.7558
MOSCOW_REFERENCE_LNG=37.6173
BOT_DATA_COLLECTION_COMPLETION_MESSAGE="Спасибо, данные сохранили."
BOT_TELEGRAM_WEBHOOK_MAX_PER_MINUTE=300
BOT_MAX_WEBHOOK_MAX_PER_MINUTE=300

BITRIX24_PORTAL_DOMAIN=crm.alexlesley.biz
BITRIX24_APP_NAME="Abrikosoff Connector"
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_AUTH_SERVER_URL=https://oauth.bitrix.info
BITRIX24_INSTALL_CALLBACK_URL=
BITRIX24_EVENTS_CALLBACK_URL=
BITRIX24_OPENLINES_CALLBACK_URL=
BITRIX24_OPENLINES_RUNTIME_APPLICATION_TOKEN_HASH=
BITRIX24_INSTALL_CALLBACK_MAX_PER_MINUTE=30
BITRIX24_EVENTS_CALLBACK_MAX_PER_MINUTE=300
BITRIX24_OPENLINES_CALLBACK_MAX_PER_MINUTE=300
BITRIX24_HTTP_TIMEOUT_SECONDS=15
BITRIX24_HTTP_CONNECT_TIMEOUT_SECONDS=5
BITRIX24_HTTP_RETRY_SLEEP_MILLISECONDS=200
BITRIX24_CONTACTS_SYNC_ENABLED=false
BITRIX24_DEALS_SYNC_ENABLED=false
BITRIX24_OPENLINES_ENABLED=false
BITRIX24_TIMELINE_HISTORY_IMPORT_ENABLED=false
BITRIX24_REVERSE_SYNC_ENABLED=false
BITRIX24_DEFAULT_ASSIGNED_USER_ID=1
BITRIX24_DEFAULT_DEAL_CATEGORY_ID=22
BITRIX24_DEFAULT_DEAL_STAGE_ID=C22:NEW
BITRIX24_TELEGRAM_SOURCE_ID=
BITRIX24_MAX_SOURCE_ID=


BITRIX24_TELEGRAM_LINE_ID=
BITRIX24_MAX_LINE_ID=
BITRIX24_TELEGRAM_CONNECTOR_CODE=
BITRIX24_MAX_CONNECTOR_CODE=
BITRIX24_FIELD_NAME_SOURCE=UF_CRM_64D7457E4DC07
BITRIX24_FIELD_AGE_EXACT=UF_CRM_1606901533
BITRIX24_FIELD_GENDER=UF_CRM_5EEB7355C13B1
