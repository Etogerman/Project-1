INBOUND_MEDIA_TRAFFIC_CHANNEL_DAILY_LIMIT_BYTES=
INBOUND_MEDIA_ATTEMPT_DEADLINE_SECONDS=21600
INBOUND_MEDIA_LEASE_STALE_SECONDS=120
INBOUND_MEDIA_RESERVATION_TTL_BUFFER_SECONDS=900
INBOUND_MEDIA_OBSERVABILITY_ATTACHMENT_SCAN_LIMIT=5000
INBOUND_MEDIA_OBSERVABILITY_ORPHAN_SCAN_LIMIT=5000
INBOUND_MEDIA_CHANNEL_MAX_ACTIVE=2
INBOUND_MEDIA_IDENTITY_MAX_ACTIVE=2
INBOUND_MEDIA_GLOBAL_MAX_ACTIVE=4
INBOUND_MEDIA_MANUAL_TO_AUTO_RATIO=3
INBOUND_MEDIA_ADMISSION_RETRY_AFTER_SECONDS=5
INBOUND_MEDIA_CLEANUP_UNIQUE_FOR_SECONDS=22500

