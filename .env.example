BITRIX24_FIELD_CONTACT_ID=UF_CRM_ABRIKOSOFF_CONTACT_ID
BITRIX24_FIELD_CHANNEL_ID=UF_CRM_ABRIKOSOFF_CHANNEL_ID
BITRIX24_FIELD_CHANNEL_NAME=UF_CRM_ABRIKOSOFF_CHANNEL_NAME
BITRIX24_FIELD_PLATFORM=UF_CRM_ABRIKOSOFF_PLATFORM
BITRIX24_FIELD_BOT_CODE=UF_CRM_ABRIKOSOFF_BOT_CODE
BITRIX24_FIELD_BOT_NAME=UF_CRM_ABRIKOSOFF_BOT_NAME
BITRIX24_FIELD_ALT_FIRST_NAME=UF_CRM_ABRIKOSOFF_ALT_FIRST_NAME
BITRIX24_FIELD_ALT_LAST_NAME=UF_CRM_ABRIKOSOFF_ALT_LAST_NAME
BITRIX24_FIELD_NAME_CONFLICT=UF_CRM_ABRIKOSOFF_NAME_CONFLICT
BITRIX24_NAME_SOURCE_AUTOMATIC_ID=7178
BITRIX24_NAME_SOURCE_SELF_REPORTED_ID=7179
BITRIX24_NAME_SOURCE_TRAINING_VERIFIED_ID=7180
BITRIX24_GENDER_MALE_ID=4653
BITRIX24_GENDER_FEMALE_ID=4655
